# =============================================================================
# VividCare – Environment Variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase – required for all database, auth, and storage operations
# Find these in: Supabase dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# Your project's public URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon / public key – used by browser and server clients for user-scoped queries
# Also accepted as NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (newer Supabase SDK name)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Newer alias for the anon key (used by lib/supabase/client.ts and server.ts as fallback)
# Leave blank if you only set NEXT_PUBLIC_SUPABASE_ANON_KEY above
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Service role key – server-side only, bypasses RLS.
# NEVER expose this to the browser or commit it to version control.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Legacy alias for the service role key (used by app/api/admin/create-user/route.ts)
# Leave blank if you only set SUPABASE_SERVICE_ROLE_KEY above
SUPABASE_SECRET_KEY=

# -----------------------------------------------------------------------------
# Anthropic – required for the AI assistant (/api/chat)
# Find this in: https://console.anthropic.com → API Keys
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=your-anthropic-api-key-here
